# Copie este arquivo para ".env" (sem o .example) e preencha com os
# valores do SEU projeto Supabase. O ".env" nunca é commitado (ver
# .gitignore na raiz) — é por isso que aqui só tem exemplo, sem segredo.
#
# Onde achar cada valor no Supabase: Project Settings → Database (URL/user/senha)
# e Project Settings → API (URL do projeto, usado para montar JWKS/issuer).

SUPABASE_DB_URL=jdbc:postgresql://db.SEU-PROJETO.supabase.co:5432/postgres
SUPABASE_DB_USER=postgres
SUPABASE_DB_PASSWORD=

SUPABASE_JWKS_URL=https://SEU-PROJETO.supabase.co/auth/v1/jwks
SUPABASE_JWT_ISSUER=https://SEU-PROJETO.supabase.co/auth/v1

# Origem do Web em desenvolvimento (Live Server, por exemplo). Separe por
# vírgula se precisar de mais de uma.
FERSA_CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Porta da API (opcional — padrão 8080)
PORT=8080

# ---------- Manuais + RAG (Gemini) ----------
# Chave em https://aistudio.google.com/apikey. Sem ela a API sobe normal,
# mas upload de manual fica com status ERRO e o /api/chat devolve 503.
GEMINI_API_KEY=
# Opcionais — os padrões já funcionam:
# GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# GEMINI_CHAT_MODEL_RESERVA=gemini-flash-latest
# GEMINI_NIVEL_RACIOCINIO=low
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# FERSA_UPLOAD_MAX=25MB
# FERSA_RAG_SCORE_MINIMO=0
