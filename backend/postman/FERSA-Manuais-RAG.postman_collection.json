{
  "info": {
    "name": "FERSA Care — Manuais + RAG",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Semana 1 (upload/ingestão) e semana 2 (chat). Preencha baseUrl e tokenAdmin (access_token do Supabase de um usuário com perfil ADMIN). Depois do upload, copie o id devolvido para a variável manualId."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "manualId",
      "value": ""
    },
    {
      "key": "categoriaId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Público",
      "item": [
        {
          "name": "Chat — perguntar",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pergunta\": \"Qual o torque da porca do cubo do FRS-1001?\"\n}"
            },
            "description": "Resposta + fontes. encontrou=false quando a resposta não está nos manuais."
          }
        },
        {
          "name": "Chat — pergunta fora dos manuais",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/chat",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "chat"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pergunta\": \"Qual a previsão do tempo para amanhã?\"\n}"
            }
          }
        },
        {
          "name": "Buscar manuais",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/manuais?termo=graxa",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "manuais"
              ],
              "query": [
                {
                  "key": "termo",
                  "value": "graxa"
                }
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Categorias ativas",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "categorias"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        },
        {
          "name": "Abrir PDF do manual",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/manuais/{{manualId}}/pdf",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "manuais",
                "{{manualId}}",
                "pdf"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          }
        }
      ]
    },
    {
      "name": "Admin — manuais",
      "item": [
        {
          "name": "Upload de PDF",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "arquivo",
                  "type": "file",
                  "src": []
                },
                {
                  "key": "titulo",
                  "value": "Manual FRS-1001",
                  "type": "text"
                },
                {
                  "key": "categoriaId",
                  "value": "{{categoriaId}}",
                  "type": "text",
                  "disabled": true
                }
              ]
            },
            "description": "Escolha o PDF no campo 'arquivo'. Responde 202 com status PROCESSANDO."
          }
        },
        {
          "name": "Listar manuais",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Ver manual (status)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais/{{manualId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais",
                "{{manualId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Ver chunks",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais/{{manualId}}/chunks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais",
                "{{manualId}}",
                "chunks"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Editar título/categoria",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais/{{manualId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais",
                "{{manualId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"titulo\": \"Manual de instalação FRS-1001\",\n  \"categoriaId\": null\n}"
            }
          }
        },
        {
          "name": "Desativar",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais/{{manualId}}/ativo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais",
                "{{manualId}}",
                "ativo"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ativo\": false\n}"
            }
          }
        },
        {
          "name": "Ativar",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais/{{manualId}}/ativo",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais",
                "{{manualId}}",
                "ativo"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "Reprocessar",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais/{{manualId}}/reprocessar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais",
                "{{manualId}}",
                "reprocessar"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Excluir",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/manuais/{{manualId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "manuais",
                "{{manualId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "Admin — categorias",
      "item": [
        {
          "name": "Listar categorias",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "categorias"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          }
        },
        {
          "name": "Criar categoria",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/categorias",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "categorias"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Rolamento de Cubo\",\n  \"descricao\": \"Rolamentos de roda\"\n}"
            }
          }
        },
        {
          "name": "Editar categoria",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/admin/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "categorias",
                "{{categoriaId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Rolamento de Cubo\",\n  \"descricao\": \"Rolamentos de roda\",\n  \"ativo\": true\n}"
            }
          }
        },
        {
          "name": "Excluir categoria",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/admin/categorias/{{categoriaId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "admin",
                "categorias",
                "{{categoriaId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{tokenAdmin}}",
                  "type": "string"
                }
              ]
            }
          }
        }
      ]
    }
  ]
}